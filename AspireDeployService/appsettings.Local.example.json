{
  "AspireDeploy": {
    "GitHub": { "Token": "<github-token-or-empty>" },
    "AI": {
      "ActiveServiceType": "AzureAIFoundry",
      "Providers": {
        "AzureAIFoundry": {
          "ApiKey": "<foundry-key>",
          "Endpoint": "https://<resource>.services.ai.azure.com/",
          "AIModel": "<deployment-name>",
          "ApiProtocol": ""
        },
        "OpenAI": { "ApiKey": "<openai-key>", "AIModel": "<model>" }
      },
      "EnableFileTools": true,
      "MaxLogTailLines": 200
    },
    "Profiles": {
      "orders-dev": {
        "Source": { "Kind": "GitHub", "Location": "<owner>/<repo>", "Ref": "main", "AppHostPath": "src/Orders.AppHost/Orders.AppHost.csproj" },
        "Destination": { "TenantId": "<tenant-guid>", "SubscriptionId": "<subscription-guid>", "Location": "eastus2", "ResourceGroup": "rg-orders-dev" },
        "Environment": "Production",
        "Parameters": { "apiKey": "<secret>", "region-name": "west", "db": "<connection-string>" },
        "SecretParameters": [ "apiKey", "db" ]
      },
      "local-shop": {
        "Source": { "Kind": "LocalFolder", "Location": "<absolute-path-to-solution>" },
        "Destination": { "SubscriptionId": "<subscription-guid>", "Location": "westus3", "ResourceGroup": "rg-shop" },
        "ContainerRuntime": "podman"
      },
      "shared-env": {
        "Source": { "Kind": "LocalFolder", "Location": "<absolute-path-to-solution>" },
        "Destination": {
          "SubscriptionId": "<subscription-guid>",
          "Location": "eastus2",
          "ResourceGroup": "rg-shared-env",
          "ContainerRegistry": { "Mode": "Existing", "Name": "<registry>", "ResourceGroup": "<shared-rg>" },
          "ContainerAppEnvironment": {
            "Mode": "New", "Name": "cae-shared-env", "LogsDestination": "existing-workspace",
            "LogsWorkspace": { "Name": "<workspace>", "ResourceGroup": "<shared-rg>" }
          },
          "AcrPullIdentity": { "Mode": "Existing", "Name": "<identity>", "ResourceGroup": "<shared-rg>" }
        }
      }
    }
  }
}
