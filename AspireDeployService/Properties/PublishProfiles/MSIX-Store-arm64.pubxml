<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package (unsigned; the Store signs it). See README "Microsoft Store package". -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- The Store requires the fourth (revision) part of the package version to be 0: 1.0.0.0. -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>0</ApplicationVersion>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <PublishAppxPackage>true</PublishAppxPackage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxPackageDir>bin\AppPackages\arm64\</AppxPackageDir>
  </PropertyGroup>
</Project>
