@implements IDisposable
@inject RunCoordinator Runs
@inject IJSRuntime JS
@inject IAzureAccountService Azure
@inject NavigationManager Nav

@* The horizontal top app bar (docs/mockups): brand, page tabs with icons, activity, Azure account, theme toggle. No sidebar. *@
<header class="ads-topbar">
    @* aria-label keeps the link named when the narrow layout hides the brand text. *@
    <a class="ads-brand" href="" aria-label="Aspire Deploy home">
        <span class="ads-brand-mark"><Icon Name="logo" Size="20" StrokeWidth="1.6" /></span>
        <span class="ads-brand-name">Aspire Deploy</span>
    </a>

    <nav class="ads-tabs" aria-label="Pages">
        <NavLink class="ads-tab" href="" Match="NavLinkMatch.All"><Icon Name="home" Size="16" /> Home</NavLink>
        <NavLink class="ads-tab" href="setup"><Icon Name="stethoscope" Size="16" /> Setup @Running("setup")</NavLink>
        @* A deploy page belongs to Profiles, so that tab stays highlighted there. *@
        <NavLink class="@($"ads-tab{(OnDeployPage ? " active" : "")}")" href="profiles"><Icon Name="layers" Size="16" /> Profiles @Running("deploy", "profile")</NavLink>
        <NavLink class="ads-tab" href="settings"><Icon Name="sliders" Size="16" /> Settings</NavLink>
        <NavLink class="ads-tab" href="guide"><Icon Name="book-open" Size="16" /> Guide</NavLink>
    </nav>

    <div class="ads-topbar-end">
        @if (ActiveCount > 0)
        {
            <span class="ads-activity" title="Background tasks running">
                <span class="ads-spinner ads-spinner-sm"></span>
                @ActiveCount running
            </span>
        }
        @if (_account is { } a)
        {
            <span class="ads-account" title="@($"az login: {a.User ?? "(unknown user)"}, tenant {a.TenantId}, default subscription {a.Name}")">
                <span class="ads-account-avatar">@Initial(a.User)</span>
                <span class="ads-account-text">
                    <span class="ads-account-name">@(a.User ?? a.Name) <span class="ads-account-dot" aria-hidden="true"></span></span>
                    <span class="ads-account-sub">@a.Name · @Short(a.TenantId)</span>
                </span>
            </span>
        }
        else if (_accountError is not null)
        {
            <a class="ads-account is-off" href="setup" title="@_accountError">
                <span class="ads-account-avatar"><Icon Name="cloud" Size="14" /></span>
                <span class="ads-account-text">
                    <span class="ads-account-name">@(_signedOut ? "Not signed in" : "Azure CLI")</span>
                    <span class="ads-account-sub">@(_signedOut ? "Sign in from a profile" : "Not available")</span>
                </span>
            </a>
        }
        <button type="button" class="btn btn-ghost btn-icon" title="@(_theme == "dark" ? "Switch to light theme" : "Switch to dark theme")"
                aria-label="Toggle theme" @onclick="ToggleThemeAsync">
            <Icon Name="@(_theme == "dark" ? "moon" : "sun")" Size="18" />
        </button>
    </div>
</header>

@code {
    private string _theme = "dark";
    private AzureSubscription? _account;
    private string? _accountError;
    private bool _signedOut;
    private ActiveRun? _signInSeen;

    private int ActiveCount => Runs.Active.Count(r => !r.Key.StartsWith("debug:", StringComparison.Ordinal));

    private bool OnDeployPage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("deploy/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Runs.RunsChanged += OnRunsChanged;
        _signInSeen = Runs.TryGet(AzureSignInButton.RunKey);
        _ = LoadAccountAsync();
    }

    /// <summary>The az login the app deploys with: the default subscription's user and tenant (the list is cached).</summary>
    private async Task LoadAccountAsync()
    {
        try
        {
            var subs = await Task.Run(() => Azure.ListSubscriptionsAsync(NullRunObserver.Instance, CancellationToken.None));
            (_account, _accountError) = (subs.FirstOrDefault(s => s.IsDefault) ?? subs.FirstOrDefault(), null);
        }
        catch (DeployerException ex)
        {
            (_account, _accountError, _signedOut) = (null, ex.Message, ex.Category == ErrorCategory.Permissions);
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string Initial(string? user) => string.IsNullOrEmpty(user) ? "?" : char.ToUpperInvariant(user[0]).ToString();

    private static string Short(string id) => id.Length > 8 ? id[..8] : id;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _theme = await JS.InvokeAsync<string>("adsTheme.get");
            StateHasChanged();
        }
        catch (JSException)
        {
            // The theme is cosmetic; keep the default.
        }
    }

    private async Task ToggleThemeAsync()
    {
        var next = _theme == "dark" ? "light" : "dark";
        try
        {
            _theme = await JS.InvokeAsync<string>("adsTheme.set", next);
        }
        catch (JSException)
        {
        }
    }

    private void OnRunsChanged()
    {
        // A finished sign-in changes who is signed in.
        if (Runs.TryGet(AzureSignInButton.RunKey) is { IsRunning: false } signIn && !ReferenceEquals(signIn, _signInSeen))
        {
            _signInSeen = signIn;
            _ = LoadAccountAsync();
        }
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Plan §6.1: a live indicator next to pages that have an active run.</summary>
    private RenderFragment? Running(params string[] prefixes) =>
        Runs.Active.Any(r => prefixes.Any(p => r.Key.StartsWith(p + ":", StringComparison.Ordinal)))
            ? @<span class="ads-tab-live" role="status" aria-label="running"></span>
            : null;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runs.RunsChanged -= OnRunsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
