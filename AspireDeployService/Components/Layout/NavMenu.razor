@implements IDisposable
@inject RunCoordinator Runs
@inject IJSRuntime JS

@* The horizontal top app bar (docs/mockups): brand, page tabs, theme toggle. No sidebar. *@
<header class="ads-topbar">
    @* aria-label keeps the link named when the narrow layout hides the brand text. *@
    <a class="ads-brand" href="" aria-label="Aspire Deploy home">
        <span class="ads-brand-mark"><Icon Name="logo" Size="20" StrokeWidth="1.6" /></span>
        <span class="ads-brand-name">Aspire Deploy</span>
    </a>

    <nav class="ads-tabs" aria-label="Pages">
        <NavLink class="ads-tab" href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink class="ads-tab" href="setup">Setup @Running("setup")</NavLink>
        <NavLink class="ads-tab" href="discover">Discover @Running("discover")</NavLink>
        <NavLink class="ads-tab" href="profiles">Profiles @Running("deploy", "profile")</NavLink>
        <NavLink class="ads-tab" href="settings">Settings</NavLink>
        <NavLink class="ads-tab" href="guide">Guide</NavLink>
    </nav>

    <div class="ads-topbar-end">
        @if (ActiveCount > 0)
        {
            <span class="ads-activity" title="Background tasks running">
                <span class="ads-spinner ads-spinner-sm"></span>
                @ActiveCount running
            </span>
        }
        <button type="button" class="btn btn-ghost btn-icon" title="@(_theme == "dark" ? "Switch to light theme" : "Switch to dark theme")"
                aria-label="Toggle theme" @onclick="ToggleThemeAsync">
            <Icon Name="@(_theme == "dark" ? "moon" : "sun")" Size="18" />
        </button>
        <a class="btn btn-ghost btn-icon" href="settings" title="Settings" aria-label="Settings"><Icon Name="sliders" Size="18" /></a>
    </div>
</header>

@code {
    private string _theme = "dark";

    private int ActiveCount => Runs.Active.Count(r => !r.Key.StartsWith("debug:", StringComparison.Ordinal));

    protected override void OnInitialized() => Runs.RunsChanged += OnRunsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _theme = await JS.InvokeAsync<string>("adsTheme.get");
            StateHasChanged();
        }
        catch (JSException)
        {
            // The theme is cosmetic; keep the default.
        }
    }

    private async Task ToggleThemeAsync()
    {
        var next = _theme == "dark" ? "light" : "dark";
        try
        {
            _theme = await JS.InvokeAsync<string>("adsTheme.set", next);
        }
        catch (JSException)
        {
        }
    }

    private void OnRunsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Plan §6.1: a live indicator next to pages that have an active run.</summary>
    private RenderFragment? Running(params string[] prefixes) =>
        Runs.Active.Any(r => prefixes.Any(p => r.Key.StartsWith(p + ":", StringComparison.Ordinal)))
            ? @<span class="ads-tab-live" role="status" aria-label="running"></span>
            : null;

    public void Dispose() => Runs.RunsChanged -= OnRunsChanged;
}
