@page "/setup"
@implements IDisposable
@inject ISetupService SetupService
@inject IProfileService Profiles
@inject RunCoordinator Runs

@* docs/mockups/setup_checklist: a summary with a pass ring, then one card per check. *@
<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow"><Icon Name="stethoscope" Size="14" /> Preflight · environment validation</div>
        <h1>Setup</h1>
        <p class="ads-lead">Checks the tools a deployment needs. With a profile, it also fetches the source and checks what its AppHost needs, and installs the matching Aspire CLI.</p>
    </div>
    <div class="ads-page-actions">
        <div class="ads-scope">
            <label class="ads-scope-label" for="setup-profile">Profile scope</label>
            <select id="setup-profile" class="form-select" @bind="_profile" @bind:after="Reattach" disabled="@Busy">
                <option value="">(general checks only)</option>
                @foreach (var p in _profiles)
                {
                    <option value="@p.Name">@p.Name</option>
                }
            </select>
        </div>
        <button class="btn btn-primary btn-lg" disabled="@Busy" @onclick="Run">
            @if (Busy)
            {
                <span class="ads-spinner ads-spinner-sm"></span> <span>Checking…</span>
            }
            else
            {
                <Icon Name="refresh" Size="15" /> <span>Run checks</span>
            }
        </button>
    </div>
</header>

<OutcomeBanner Run="_run" Page="Setup" />

@if (_run?.ValueAs<IReadOnlyList<PrerequisiteCheck>>() is { } checks)
{
    var passed = checks.Count(c => c.State == CheckState.Pass);
    var warned = checks.Count(c => c.State == CheckState.Warn);
    var failed = checks.Count(c => c.State == CheckState.Fail);
    var total = Math.Max(1, checks.Count);
    var percent = (int)Math.Round(100.0 * passed / total);
    <div class="ads-card ads-summary mb-3">
        <div class="ads-summary-main">
            <svg class="ads-ring @(failed > 0 ? "is-fail" : warned > 0 ? "is-warn" : "is-pass")" width="72" height="72" viewBox="0 0 72 72" role="img" aria-label="@percent percent passed">
                <circle cx="36" cy="36" r="30" class="ads-ring-track" />
                <circle cx="36" cy="36" r="30" class="ads-ring-value" stroke-dasharray="@($"{188.5 * passed / total:0.0} 188.5")" />
                <text x="36" y="40" text-anchor="middle">@percent%</text>
            </svg>
            <div class="ads-summary-text">
                <div class="ads-summary-counts">
                    <span class="ads-pass-text">@passed passed</span>
                    <span class="ads-summary-sep">·</span>
                    <span class="@(warned > 0 ? "ads-warn-text" : "ads-subtle")">@warned @(warned == 1 ? "warning" : "warnings")</span>
                    <span class="ads-summary-sep">·</span>
                    <span class="@(failed > 0 ? "ads-fail-text" : "ads-subtle")">@failed failed</span>
                </div>
                <div class="ads-muted">
                    @(failed > 0 ? "Fix the failed checks below before deploying." : warned > 0 ? "Ready to deploy; review the warnings below." : "Everything needed is in place.")
                </div>
            </div>
            <span class="ads-spacer"></span>
            @if (_run.Result is not null)
            {
                <div class="ads-summary-meta">
                    <span class="ads-fact-label">Last run</span>
                    <span class="ads-mono">@_run.StartedUtc.ToLocalTime().ToString("t")@(_profile is { Length: > 0 } scope ? $" · {scope}" : "")</span>
                </div>
            }
        </div>
        <div class="ads-progress" aria-hidden="true">
            <span class="ads-progress-pass" style="width: @(100.0 * passed / total)%"></span>
            <span class="ads-progress-warn" style="width: @(100.0 * warned / total)%"></span>
            <span class="ads-progress-fail" style="width: @(100.0 * failed / total)%"></span>
        </div>
    </div>

    <div class="ads-checks">
        @foreach (var c in checks)
        {
            var check = c;
            <div class="ads-check @StateClass(c.State)">
                <span class="ads-tile-icon ads-tile-sm @TileTone(c.State)"><Icon Name="@CheckIcon(c.Name)" Size="16" /></span>
                <div class="ads-check-body">
                    <div class="ads-check-title">
                        <span class="ads-check-name">@c.Name</span>
                        @if (Probe(c.Name) is { } probe)
                        {
                            <span class="ads-check-probe">@probe</span>
                        }
                    </div>
                    <div class="ads-check-detail">@c.Detail</div>
                    @if (c.Fix is { Length: > 0 } fix)
                    {
                        var (text, command) = SplitFix(fix);
                        <div class="ads-check-fix">
                            <Icon Name="zap" Size="14" />
                            <span>@(text.Length > 0 ? text : "Recommended fix:")</span>
                            @if (command is not null)
                            {
                                <code class="ads-check-cmd">@command</code>
                                <span class="ads-spacer"></span>
                                <button class="btn btn-sm btn-ghost" title="Copy command" @onclick="() => CopyAsync(command)">
                                    <Icon Name="@(_copied == command ? "check" : "copy")" Size="13" /> @(_copied == command ? "Copied" : "Copy fix")
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="ads-check-end">
                    <span class="ads-pill @StatePill(c.State)">@c.State</span>
                    @if (c.State is CheckState.Fail or CheckState.Warn)
                    {
                        <AIHelpButton GetContext="@(() => AIHelpContexts.FromCheck(check, _run))" Compact="true" />
                    }
                </div>
            </div>
        }
    </div>
}
else if (_run is null)
{
    <div class="ads-empty">
        <span class="ads-tile-icon"><Icon Name="stethoscope" Size="24" /></span>
        <h2>No checks run yet</h2>
        <p class="mb-0">Choose a profile scope, or keep the general checks, and select <strong>Run checks</strong>.</p>
    </div>
}

<LogViewer Run="_run" Page="Setup" />

@code {
    private IReadOnlyList<ProfileSummary> _profiles = [];
    private string? _profile = "";
    private ActiveRun? _run;
    private string? _copied;

    private bool Busy => _run?.IsRunning == true;
    private string Key => "setup:" + (_profile is { Length: > 0 } p ? p : "general");

    protected override async Task OnInitializedAsync()
    {
        Runs.RunsChanged += OnRunsChanged;
        if (Profiles.Location.ParseError is null)
            _profiles = await Profiles.ListAsync(CancellationToken.None);
        // Come back to the last run, whichever profile it was for, so its banner, log and Cancel return too.
        if (Runs.Latest("setup:") is { } latest)
            _profile = latest.Key == "setup:general" ? "" : latest.Key["setup:".Length..];
        _run = Runs.TryGet(Key);
    }

    private void Run()
    {
        var profile = _profile is { Length: > 0 } p ? p : null;
        _copied = null;
        _run = Runs.Start(Key, "Setup", (observer, ct) => SetupService.CheckAsync(profile, observer, ct),
            checks => checks.Any(c => c.State == CheckState.Fail)
                ? new OperationResult(OutcomeCode.MissingPrerequisite, $"{checks.Count(c => c.State == CheckState.Fail)} check(s) failed. See the Fix column.")
                : OperationResult.Ok("Everything needed is in place."));
    }

    private async Task CopyAsync(string command)
    {
        await Clipboard.Default.SetTextAsync(command);
        _copied = command;
    }

    /// <summary>Fix texts that end in "run: &lt;command&gt;" show the command in a copyable box.</summary>
    private static (string Text, string? Command) SplitFix(string fix)
    {
        var at = fix.LastIndexOf("run: ", StringComparison.OrdinalIgnoreCase);
        if (at < 0)
            return (fix, null);
        var command = fix[(at + 5)..].Trim().TrimEnd('.');
        var text = fix[..at].Trim().TrimEnd(',');
        return (text.Length == 0 ? "" : text + (text.EndsWith("then", StringComparison.OrdinalIgnoreCase) ? " run:" : ""), command);
    }

    private static string StatePill(CheckState s) => s switch
    {
        CheckState.Pass => "ads-pill-pass",
        CheckState.Warn => "ads-pill-warn",
        _ => "ads-pill-fail"
    };

    private static string StateClass(CheckState s) => s switch { CheckState.Warn => "is-warn", CheckState.Fail => "is-fail", _ => "" };

    private static string TileTone(CheckState s) => s switch
    {
        CheckState.Pass => "ads-tone-pass",
        CheckState.Warn => "ads-tone-warn",
        _ => "ads-tone-fail"
    };

    /// <summary>The command each check runs (PrerequisiteChecker), shown next to its name.</summary>
    private static string? Probe(string name) => name switch
    {
        ".NET SDK" => "dotnet --list-sdks",
        "Azure CLI sign-in" => "az account show",
        "Container runtime" => "docker info",
        "Node.js" => "node --version",
        "GitHub CLI" => "gh --version",
        "Aspire CLI" => "aspire --version",
        _ => null
    };

    private static string CheckIcon(string name) => name switch
    {
        _ when name.Contains(".NET", StringComparison.Ordinal) => "terminal",
        _ when name.Contains("Azure", StringComparison.Ordinal) => "cloud",
        _ when name.Contains("Container", StringComparison.Ordinal) => "layers",
        _ when name.Contains("Node", StringComparison.Ordinal) => "code",
        _ when name.Contains("GitHub", StringComparison.Ordinal) => "github",
        _ when name.Contains("Aspire", StringComparison.Ordinal) => "box",
        _ when name.Contains("source", StringComparison.OrdinalIgnoreCase) => "git-branch",
        _ => "shield-check"
    };

    private void Reattach() => _run = Runs.TryGet(Key);

    private void OnRunsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Runs.RunsChanged -= OnRunsChanged;
}
