@page "/settings"
@inject IProfileService Profiles
@inject AIHelpService Help

<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow">Configuration</div>
        <h1>Settings</h1>
        <p class="ads-lead">Where this app keeps its settings, work and tools, the GitHub token used for private repositories, and the AI assistant.</p>
    </div>
</header>

@if (_snapshot is { } s)
{
    <div class="ads-stack">
        @if (s.Location.ParseError is { } error)
        {
            <div class="ads-callout ads-callout-error">
                <Icon Name="x-circle" Size="17" />
                <div class="ads-callout-body">
                    <div class="ads-callout-title">The settings file cannot be read.</div>
                    <div class="mb-1">Nothing is saved until it is fixed by hand; the file is never overwritten.</div>
                    <code>@error</code>
                </div>
            </div>
        }

        <div class="ads-card">
            <div class="ads-card-header"><Icon Name="folder" Size="18" /><h2>Locations</h2></div>
            <div class="ads-stack gap-3">
                <div>
                    <div class="form-label">Settings file</div>
                    <div class="ads-path">
                        <Icon Name="file-text" Size="15" />
                        <span>@s.Location.Path</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenFolder(Path.GetDirectoryName(s.Location.Path)!)"><Icon Name="external-link" Size="13" /> Open folder</button>
                    </div>
                    <div class="form-text">Found by: @RuleText(s.Location.Rule)@(s.Location.Exists ? "" : " (not created yet)")</div>
                </div>
                <div>
                    <div class="form-label">Work root</div>
                    <div class="ads-path">
                        <Icon Name="folder" Size="15" />
                        <span>@s.Options.WorkRoot</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenFolder(s.Options.WorkRoot)"><Icon Name="external-link" Size="13" /> Open folder</button>
                    </div>
                    <div class="form-text">Source copies, logs and history, one folder per profile.</div>
                </div>
                <div>
                    <div class="form-label">Tools root</div>
                    <div class="ads-path">
                        <Icon Name="box" Size="15" />
                        <span>@s.Options.ToolsRoot</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenFolder(s.Options.ToolsRoot)"><Icon Name="external-link" Size="13" /> Open folder</button>
                    </div>
                    <div class="form-text">Aspire CLI versions installed to match each AppHost.</div>
                </div>
            </div>
        </div>

        @if (s.Location.ParseError is null)
        {
            var hasToken = !string.IsNullOrEmpty(s.Options.GitHubToken);
            <div class="ads-card">
                <div class="ads-card-header">
                    <Icon Name="github" Size="18" /><h2>GitHub token</h2>
                    <span class="ads-spacer"></span>
                    <span class="ads-pill @(hasToken ? "ads-pill-pass" : "")">@(hasToken ? "Set" : "Not set")</span>
                </div>
                <p class="ads-muted">
                    <span class="ads-code">AspireDeploy:GitHub:Token</span> is used for private repositories when a profile has no token of its own.
                    Use a fine-grained token with <strong>Contents: read</strong> on the selected repositories only. It is stored in plain text in the settings file, which git ignores.
                </p>
                @if (_replacing)
                {
                    <div class="ads-row align-items-start" style="max-width: 40rem">
                        <div class="flex-grow-1"><SecretInput @bind-Value="_newToken" Placeholder="github_pat_..." CssClass="ads-mono-input" /></div>
                        <button class="btn btn-primary" @onclick="() => SaveTokenAsync(_newToken)"><Icon Name="check" Size="14" /> Save</button>
                        <button class="btn btn-outline-secondary" @onclick="() => { _replacing = false; _newToken = null; }">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="ads-secret">
                        <span class="ads-secret-value"><Icon Name="lock" Size="13" /> @(hasToken ? "•••••• (set)" : "(not set)")</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _replacing = true">Replace</button>
                        @if (hasToken)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="ClearTokenAsync">Clear</button>
                        }
                    </div>
                }
                @if (_message is { } m)
                {
                    <div class="ads-callout @(_failed ? "ads-callout-error" : "ads-callout-success") mt-3">
                        <Icon Name="@(_failed ? "x-circle" : "check-circle")" Size="17" />
                        <div class="ads-callout-body">@m</div>
                        @if (_failed)
                        {
                            <AIHelpButton GetContext="@(() => AIHelpContexts.FromError("Settings", m))" Compact="true" />
                        }
                    </div>
                }
            </div>

            <AISettingsCard />
        }
    </div>
}

@code {
    private SettingsSnapshot? _snapshot;
    private bool _replacing;
    private string? _newToken;
    private string? _message;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Profiles.LoadAsync(CancellationToken.None);
        // Picks up hand edits of the AI settings, so AI Help buttons appear without a restart.
        await Help.RefreshAsync();
    }

    private Task ClearTokenAsync() => WriteTokenAsync(null);

    /// <summary>An empty value after "Replace" keeps the current token; only the Clear button removes it.</summary>
    private async Task SaveTokenAsync(string? token)
    {
        if (string.IsNullOrWhiteSpace(token))
        {
            (_message, _failed) = ("Nothing was entered, so the token is unchanged.", false);
            _replacing = false;
            _newToken = null;
            return;
        }
        await WriteTokenAsync(token.Trim());
    }

    private async Task WriteTokenAsync(string? token)
    {
        try
        {
            await Profiles.SetGlobalGitHubTokenAsync(token, CancellationToken.None);
            (_message, _failed) = (token is null ? "Token cleared." : "Token saved.", false);
            _replacing = false;
            _newToken = null;
            _snapshot = await Profiles.LoadAsync(CancellationToken.None);
        }
        catch (DeployerException ex)
        {
            (_message, _failed) = (ex.Message, true);
        }
    }

    private static string RuleText(SettingsRule rule) => rule switch
    {
        SettingsRule.EnvironmentVariable => "the ADS_SETTINGS environment variable",
        SettingsRule.ProjectFolder => "the project folder (running from Visual Studio)",
        _ => "%LOCALAPPDATA%\\AspireDeployService"
    };

    private static void OpenFolder(string folder)
    {
        Directory.CreateDirectory(folder);
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", folder) { UseShellExecute = true });
    }
}
