@page "/deploy/{Name}"
@implements IDisposable
@inject IProfileService Profiles
@inject IDeployService Deployer
@inject RunCoordinator Runs

<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow"><a href="profiles" class="ads-eyebrow-link"><Icon Name="arrow-left" Size="12" /> Profiles</a></div>
        <h1>Deploy @Name</h1>
        <p class="ads-lead">Runs <span class="ads-code">aspire deploy</span> with this profile and your <span class="ads-code">az login</span>. You confirm the target before anything is created.</p>
    </div>
    @if (_profile is not null)
    {
        <div class="ads-page-actions">
            <a class="btn btn-outline-secondary" href="profiles/@Name"><Icon Name="pencil" Size="14" /> Edit profile</a>
        </div>
    }
</header>

@if (_error is { } e)
{
    <div class="ads-callout ads-callout-error mb-3">
        <Icon Name="x-circle" Size="17" />
        <div class="ads-callout-body">@e</div>
    </div>
}

@if (_profile is { } p)
{
    <div class="ads-card mb-3">
        <div class="ads-card-header">
            <Icon Name="shield-check" Size="18" />
            <h2>Flight check</h2>
            <span class="ads-spacer"></span>
            <span class="ads-chip">@p.Source.Kind</span>
        </div>
        <dl class="ads-defs ads-defs-4">
            <div><dt>Source</dt><dd class="ads-mono">@p.ToSourceSpec().Display</dd></div>
            <div><dt>Subscription</dt><dd class="ads-mono">@p.Destination.SubscriptionId</dd></div>
            <div>
                <dt>Resource group</dt>
                <dd class="ads-mono">@p.Destination.ResourceGroup <span class="ads-chip ads-chip-azure ms-1">@p.Destination.Location</span></dd>
            </div>
            <div>
                <dt>Environment</dt>
                <dd>@p.EnvironmentName<span class="ads-def-caption">Last deployed with Aspire @(p.LastDeployedAspireVersion ?? "(never deployed)")</span></dd>
            </div>
        </dl>

        <div class="ads-card-footer">
            @if (p.Source.Kind == SourceKind.GitHub)
            {
                <div style="min-width: 14rem">
                    <label class="form-label" for="dp-ref">Ref for this run</label>
                    <input id="dp-ref" class="form-control ads-mono-input" placeholder="@(p.Source.Ref ?? "default branch")" @bind="_ref" disabled="@Busy" />
                </div>
            }
            <div class="ads-stack gap-2">
                <div class="form-check form-switch mb-0">
                    <input id="dp-dry" class="form-check-input" type="checkbox" role="switch" @bind="_dryRun" disabled="@Busy" />
                    <label class="form-check-label" for="dp-dry">Dry run (list the steps only)</label>
                </div>
                <div class="form-check form-switch mb-0">
                    <input id="dp-clear" class="form-check-input" type="checkbox" role="switch" @bind="_clearCache" disabled="@Busy" />
                    <label class="form-check-label" for="dp-clear">Clear Aspire's deploy cache</label>
                </div>
            </div>
            <span class="ads-spacer"></span>
            <button class="btn btn-primary btn-lg" disabled="@Busy" @onclick="Start">
                @if (Busy)
                {
                    <span class="ads-spinner ads-spinner-sm"></span> <span>@(_run!.Title) running…</span>
                }
                else
                {
                    <Icon Name="@(_dryRun ? "list" : "rocket")" Size="16" /> <span>@(_dryRun ? "List steps" : "Deploy")</span>
                }
            </button>
        </div>
    </div>

    <OutcomeBanner Run="_run" ExtraLine="@($"Resource group: {p.Destination.ResourceGroup}. To remove everything, delete that resource group in Azure.")" />
}

<LogViewer Run="_run" />

@code {
    [Parameter] public string Name { get; set; } = "";

    private DeployProfile? _profile;
    private string? _ref;
    private bool _dryRun;
    private bool _clearCache;
    private string? _error;
    private ActiveRun? _run;

    private bool Busy => _run?.IsRunning == true;
    private string Key => "deploy:" + Name;

    protected override async Task OnParametersSetAsync()
    {
        Runs.RunsChanged -= OnRunsChanged;
        Runs.RunsChanged += OnRunsChanged;
        _run = Runs.TryGet(Key);
        _profile = await Profiles.GetAsync(Name, CancellationToken.None);
        _error = _profile is null ? $"Profile '{Name}' does not exist." : null;
    }

    private void Start()
    {
        var request = new DeployRequest(Name, string.IsNullOrWhiteSpace(_ref) ? null : _ref.Trim(), _dryRun, _clearCache);
        _run = Runs.Start(Key, _dryRun ? "Dry run" : "Deployment", (observer, ct) => Deployer.DeployAsync(request, observer, ct));
    }

    private void OnRunsChanged() => _ = InvokeAsync(async () =>
    {
        if (_run is { IsRunning: false })
            _profile = await Profiles.GetAsync(Name, CancellationToken.None); // picks up LastDeployedAspireVersion (D18)
        StateHasChanged();
    });

    public void Dispose() => Runs.RunsChanged -= OnRunsChanged;
}
