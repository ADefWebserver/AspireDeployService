@page "/profiles/{Name}"
@implements IDisposable
@inject IProfileService Profiles
@inject RunCoordinator Runs

<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow"><a href="profiles" class="ads-eyebrow-link"><Icon Name="arrow-left" Size="12" /> Profiles</a></div>
        <h1>Profile @Name</h1>
        <p class="ads-lead">Where the source comes from, where it is deployed, and the parameter values it is deployed with.</p>
    </div>
    @if (_session is not null)
    {
        <div class="ads-page-actions">
            <a class="btn btn-outline-secondary" href="profiles"><Icon Name="arrow-left" Size="14" /> Back</a>
            <button class="btn btn-outline-secondary" disabled="@(Busy || _readOnly)" @onclick="SaveAsync"><Icon Name="check" Size="14" /> Save</button>
            <a class="btn btn-primary" href="deploy/@Name"><Icon Name="rocket" Size="14" /> Deploy…</a>
        </div>
    }
</header>

@if (_error is { } e)
{
    <div class="ads-callout ads-callout-error mb-3">
        <Icon Name="x-circle" Size="17" />
        <div class="ads-callout-body ads-pre-line">@e</div>
        <AIHelpButton GetContext="@(() => AIHelpContexts.FromError("Edit profile", e))" Compact="true" />
    </div>
}
@if (_saved)
{
    <div class="ads-banner ads-banner-success">
        <span class="ads-banner-icon"><Icon Name="check-circle" Size="18" /></span>
        <div class="ads-banner-body"><span class="ads-banner-title">Saved.</span></div>
    </div>
}

@if (_session is { } s)
{
    var p = s.Edited;
    var o = s.Original;
    var busy = Busy;
    @if (busy)
    {
        <div class="ads-callout ads-callout-info mb-3">
            <Icon Name="info" Size="17" />
            <div class="ads-callout-body">A deployment of this profile is running; editing is disabled until it ends.</div>
        </div>
    }
    <fieldset disabled="@(busy || _readOnly)" class="ads-stack">
        <div class="ads-card">
            <div class="ads-card-header"><Icon Name="git-branch" Size="18" /><h2>Source</h2></div>
            <div class="ads-form-grid">
                <div class="ads-span-4">
                    <div class="form-label">Kind</div>
                    <span class="ads-chip"><Icon Name="@(o.Source.Kind == SourceKind.GitHub ? "github" : "folder")" Size="12" /> @o.Source.Kind</span>
                </div>
                <div class="ads-span-8">
                    <div class="form-label">Location</div>
                    <div class="ads-path"><span>@o.Source.Location</span></div>
                </div>
                @if (o.Source.Kind == SourceKind.GitHub)
                {
                    <div class="ads-span-4">
                        <label class="form-label" for="pe-ref">Branch, tag or SHA</label>
                        <input id="pe-ref" class="form-control ads-mono-input" placeholder="default branch" @bind="p.Source.Ref" />
                    </div>
                }
                <div class="@(o.Source.Kind == SourceKind.GitHub ? "ads-span-8" : "")">
                    <label class="form-label" for="pe-apphost">AppHost path</label>
                    <input id="pe-apphost" class="form-control ads-mono-input" placeholder="found automatically" @bind="p.Source.AppHostPath" />
                </div>
                @if (o.Source.Kind == SourceKind.GitHub)
                {
                    <div>
                        <div class="form-label">GitHub token for this profile</div>
                        <SecretField Label="token" HasValue="@(!string.IsNullOrEmpty(o.Source.GitHubToken))" Original="@o.Source.GitHubToken"
                                     Replacement="@s.TokenReplacement" ReplacementChanged="v => s.TokenReplacement = v"
                                     Cleared="@s.TokenCleared" ClearedChanged="c => s.TokenCleared = c" />
                    </div>
                }
            </div>
        </div>

        <div class="ads-card">
            <div class="ads-card-header"><Icon Name="cloud" Size="18" /><h2>Destination</h2></div>
            <AzureDestinationEditor @key="s" Profile="p" ProfileName="@Name" IdPrefix="pe" />
        </div>

        <div class="ads-card">
            <div class="ads-card-header">
                <Icon Name="key" Size="18" /><h2>Parameters</h2>
                <p class="ads-card-desc">An empty value means the AppHost's own configuration supplies it. Removing a parameter makes it missing.</p>
            </div>
            <div class="ads-table-wrap mb-3">
                <table class="ads-table">
                    <thead><tr><th>Name</th><th>Value</th><th>Secret</th><th>Config key override</th><th></th></tr></thead>
                    <tbody>
                        @if (p.Parameters.Count == 0)
                        {
                            <tr><td colspan="5" class="ads-muted">No parameters.</td></tr>
                        }
                        @foreach (var name in p.Parameters.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList())
                        {
                            var isSecret = s.IsSecret(name);
                            <tr @key="name">
                                <td class="ads-cell-mono ads-cell-name">@name</td>
                                <td style="min-width: 18rem">
                                    @if (s.IsMasked(name))
                                    {
                                        <SecretField Label="@name" HasValue="@(o.Parameters[name].Length > 0)" Original="@o.Parameters[name]"
                                                     Replacement="@s.ReplacementFor(name)" ReplacementChanged="v => s.Replace(name, v)"
                                                     Cleared="@s.IsCleared(name)" ClearedChanged="c => s.Clear(name, c)" />
                                    }
                                    else if (isSecret)
                                    {
                                        <SecretInput Value="@p.Parameters[name]" ValueChanged="v => p.Parameters[name] = v ?? string.Empty" CssClass="form-control-sm" />
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm ads-mono-input" value="@p.Parameters[name]" @onchange="ev => p.Parameters[name] = ev.Value?.ToString() ?? string.Empty" />
                                    }
                                </td>
                                <td>
                                    <div class="form-check form-switch mb-0">
                                        <input type="checkbox" class="form-check-input" role="switch" aria-label="Secret" checked="@isSecret" @onchange="ev => s.SetSecret(name, (bool)ev.Value!)" />
                                    </div>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm ads-mono-input" placeholder="@($"Parameters:{name}")" value="@p.ParameterConfigKeys.GetValueOrDefault(name)"
                                           @onchange="ev => SetConfigKey(p, name, ev.Value?.ToString())" />
                                </td>
                                <td class="ads-cell-end">
                                    <button class="btn btn-sm btn-ghost btn-icon" title="Remove" aria-label="@($"Remove {name}")" @onclick="() => s.Remove(name)"><Icon Name="trash" Size="14" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="input-group" style="max-width: 28rem">
                <input class="form-control ads-mono-input" placeholder="parameter name" @bind="_newParameter" />
                <button class="btn btn-outline-secondary" @onclick="AddParameter"><Icon Name="plus" Size="14" /> Add parameter</button>
            </div>
        </div>

        <div class="ads-row">
            <span class="ads-meta"><span><Icon Name="box" Size="13" /> Last deployed with Aspire: @(o.LastDeployedAspireVersion ?? "never")</span></span>
            <span class="ads-spacer"></span>
            <a class="btn btn-outline-secondary" href="profiles">Back</a>
            <button class="btn btn-primary" @onclick="SaveAsync"><Icon Name="check" Size="14" /> Save</button>
        </div>
    </fieldset>
}
else if (_error is null)
{
    <p class="ads-muted">Loading…</p>
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private ProfileEditSession? _session;
    private string? _newParameter;
    private string? _error;
    private bool _saved;
    private bool _readOnly;

    private bool Busy => Runs.TryGet("deploy:" + Name)?.IsRunning == true;

    protected override void OnInitialized() => Runs.RunsChanged += OnRunsChanged;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _saved = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var location = Profiles.Location;
        _readOnly = location.ParseError is not null;
        if (_readOnly)
            _error = $"The settings file cannot be read, so editing is disabled: {location.ParseError}";
        var original = await Profiles.GetAsync(Name, CancellationToken.None);
        if (original is null)
        {
            _error ??= $"Profile '{Name}' does not exist.";
            _session = null;
            return;
        }
        // Saved secret values never go into inputs (plan §6.1); the session tracks what the user changed.
        _session = new ProfileEditSession(original);
    }

    private static void SetConfigKey(DeployProfile p, string name, string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) p.ParameterConfigKeys.Remove(name); else p.ParameterConfigKeys[name] = key.Trim();
    }

    private void AddParameter()
    {
        if (_newParameter is { } name && _session!.Add(name))
            _newParameter = null;
    }

    /// <summary>Writes only what changed, onto a fresh copy of the profile (D16), and never rewrites an untouched secret.</summary>
    private async Task SaveAsync()
    {
        _saved = false;
        var session = _session!;
        try
        {
            await Profiles.UpdateAsync(Name, session.ApplyTo, CancellationToken.None);
            _error = null;
            await LoadAsync();
            _saved = true;
        }
        catch (DeployerException ex)
        {
            _error = ex.Message;
        }
    }

    // The deploy-running state decides whether the form is disabled, so re-render when runs start or end.
    // Resource pickers plan D15: a deploy may have switched a created section to Use existing, so reload when it ends.
    // The form was disabled while it ran, so no unsaved edits are lost.
    private bool _wasBusy;

    private void OnRunsChanged() => _ = InvokeAsync(async () =>
    {
        var busy = Busy;
        if (_wasBusy && !busy)
            await LoadAsync();
        _wasBusy = busy;
        StateHasChanged();
    });

    public void Dispose() => Runs.RunsChanged -= OnRunsChanged;
}
