@page "/"
@inject IProfileService Profiles
@inject RunCoordinator Runs

<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow">Aspire 13.x · Azure</div>
        <h1>Aspire Deploy</h1>
        <p class="ads-lead">
            Discover what an Aspire 13.x AppHost needs, keep per-developer deploy profiles, and deploy it to Azure with
            <span class="ads-code">aspire deploy</span> and your own <span class="ads-code">az login</span>.
        </p>
    </div>
    <div class="ads-page-actions">
        <a class="btn btn-outline-secondary" href="setup"><Icon Name="stethoscope" Size="15" /> Run checks</a>
        <a class="btn btn-primary" href="profiles/new"><Icon Name="plus" Size="15" /> New profile</a>
    </div>
</header>

<div class="ads-section-label">01 // Getting started <span class="ads-section-sub">· four steps to a deployment</span></div>
<div class="ads-steps">
    <div class="ads-card ads-step">
        <div class="ads-step-top">
            <span class="ads-tile-icon ads-tone-pass"><Icon Name="stethoscope" Size="19" /></span>
            @StepState(Runs.Latest("setup:"), "Passed")
        </div>
        <span class="ads-step-num">Step 1</span>
        <h3>Check prerequisites</h3>
        <p>Verify the .NET SDK, Azure CLI sign-in, a container runtime and the Aspire CLI.</p>
        <a class="btn btn-outline-secondary" href="setup"><Icon Name="refresh" Size="14" /> Run Setup</a>
    </div>
    <div class="ads-card ads-step">
        <div class="ads-step-top">
            <span class="ads-tile-icon"><Icon Name="compass" Size="19" /></span>
            @StepState(Runs.Latest("discover:"), "Discovered")
        </div>
        <span class="ads-step-num">Step 2</span>
        <h3>Discover an AppHost</h3>
        <p>Scan a local folder or a GitHub repository for its parameters and resources.</p>
        <a class="btn btn-outline-secondary" href="discover"><Icon Name="search" Size="14" /> Discover</a>
    </div>
    <div class="ads-card ads-step">
        <div class="ads-step-top">
            <span class="ads-tile-icon ads-tone-run"><Icon Name="sliders" Size="19" /></span>
            @if (_profiles is { Count: > 0 } saved)
            {
                <span class="ads-pill ads-pill-primary">@saved.Count saved</span>
            }
        </div>
        <span class="ads-step-num">Step 3</span>
        <h3>Create a profile</h3>
        <p>Pick the subscription, region and resource group, and fill in the parameters.</p>
        <a class="btn btn-outline-secondary" href="profiles/new"><Icon Name="plus-circle" Size="14" /> New profile</a>
    </div>
    <div class="ads-card ads-step">
        <div class="ads-step-top">
            <span class="ads-tile-icon"><Icon Name="rocket" Size="19" /></span>
            <span class="ads-subtle ads-mono ads-small">Target: Azure</span>
        </div>
        <span class="ads-step-num">Step 4</span>
        <h3>Deploy</h3>
        <p>Run <span class="ads-code">aspire deploy</span> with the profile and follow the live log.</p>
        <a class="btn btn-primary" href="profiles"><Icon Name="play" Size="13" /> Deploy</a>
    </div>
</div>

@if (_location is { } location)
{
    <div class="ads-section-label">02 // Settings file <span class="ads-section-sub">· where profiles are kept</span></div>
    <div class="ads-card">
        <div class="ads-card-header">
            <Icon Name="file-text" Size="18" />
            <h2>Settings file</h2>
            <span class="ads-spacer"></span>
            @if (location.ParseError is not null)
            {
                <span class="ads-pill ads-pill-fail">Cannot be read</span>
            }
            else if (location.Exists)
            {
                <span class="ads-pill ads-pill-pass">Loaded</span>
            }
            else
            {
                <span class="ads-pill">Not created yet</span>
            }
        </div>
        <div class="ads-path">
            <Icon Name="folder" Size="15" />
            <span>@location.Path</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyAsync(location.Path)"><Icon Name="@(_copied ? "check" : "copy")" Size="13" /> @(_copied ? "Copied" : "Copy")</button>
        </div>
        @if (location.ParseError is { } error)
        {
            <div class="ads-callout ads-callout-error mt-3">
                <Icon Name="x-circle" Size="17" />
                <div class="ads-callout-body">
                    <div class="ads-callout-title">The settings file cannot be read, so the app is read-only until it is fixed.</div>
                    <code>@error</code>
                </div>
            </div>
        }
        else
        {
            <div class="ads-meta mt-3">
                @if (location.Exists)
                {
                    <span class="ads-yes"><Icon Name="check" Size="13" /> Exists on disk</span>
                }
                else
                {
                    <span>The first saved profile creates it.</span>
                }
                @if (_profiles is { } list)
                {
                    <span class="ads-meta-sep">·</span>
                    <span>Profiles: @list.Count configured</span>
                }
            </div>
        }
    </div>
}

@if (_profiles is { Count: > 0 } profiles)
{
    <div class="ads-section-label">
        03 // Deployment profiles <span class="ads-section-sub">· recent</span>
        <a class="ads-section-end" href="profiles">View all <Icon Name="arrow-right" Size="12" /></a>
    </div>
    <div>
        @foreach (var p in profiles.Take(3))
        {
            var running = Runs.TryGet("deploy:" + p.Name)?.IsRunning == true;
            <div class="ads-card ads-card-interactive ads-profile">
                <span class="ads-tile-icon ads-tone-neutral"><Icon Name="@(p.SourceKind == SourceKind.GitHub ? "github" : "folder")" Size="18" /></span>
                <div class="ads-profile-body">
                    <div class="ads-profile-title">
                        <a href="profiles/@p.Name">@p.Name</a>
                        <span class="ads-chip">@p.SourceKind</span>
                    </div>
                    <div class="ads-meta">
                        <span><Icon Name="@(p.SourceKind == SourceKind.GitHub ? "code" : "server")" Size="13" /> @p.SourceDisplay</span>
                        @if (p.ResourceGroup is { Length: > 0 } rg)
                        {
                            <span class="ads-meta-sep">·</span>
                            <span><Icon Name="cloud" Size="13" /> @rg</span>
                        }
                    </div>
                </div>
                <div class="ads-profile-actions">
                    <a class="btn btn-primary btn-sm" href="deploy/@p.Name">
                        @if (running)
                        {
                            <span class="ads-spinner ads-spinner-sm"></span> <span>Deploying…</span>
                        }
                        else
                        {
                            <Icon Name="play" Size="12" /> <span>Deploy</span>
                        }
                    </a>
                </div>
            </div>
        }
    </div>
}

@code {
    private SettingsLocation? _location;
    private IReadOnlyList<ProfileSummary>? _profiles;
    private bool _copied;

    protected override async Task OnInitializedAsync()
    {
        _location = Profiles.Location;
        if (_location.ParseError is null)
            _profiles = await Profiles.ListAsync(CancellationToken.None);
    }

    private async Task CopyAsync(string text)
    {
        await Clipboard.Default.SetTextAsync(text);
        _copied = true;
    }

    /// <summary>The state of the latest run for a step, if there was one this session.</summary>
    private static RenderFragment? StepState(ActiveRun? run, string passed) => run switch
    {
        { IsRunning: true } => @<span class="ads-pill ads-pill-run">Running</span>,
        { Result.Succeeded: true } => @<span class="ads-pill ads-pill-pass">@passed</span>,
        { Result: not null } => @<span class="ads-pill ads-pill-fail">Failed</span>,
        _ => null
    };
}
