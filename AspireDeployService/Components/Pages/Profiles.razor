@page "/profiles"
@implements IDisposable
@inject IProfileService ProfileService
@inject RunCoordinator Runs

<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow">Deployment profiles</div>
        <h1>Profiles</h1>
        <p class="ads-lead">One profile per AppHost and Azure destination, kept in your local settings file.</p>
    </div>
    <div class="ads-page-actions">
        <a class="btn btn-primary" href="profiles/new"><Icon Name="plus" Size="15" /> New profile</a>
    </div>
</header>

@if (_error is { } e)
{
    <div class="ads-callout ads-callout-error mb-3">
        <Icon Name="x-circle" Size="17" />
        <div class="ads-callout-body ads-pre-line">@e</div>
        <AIHelpButton GetContext="@(() => AIHelpContexts.FromError("Profiles", e))" Compact="true" />
    </div>
}

@if (_pendingDelete is { } name)
{
    <div class="ads-card ads-delete mb-3">
        <div class="ads-card-header">
            <span class="ads-tile-icon ads-tone-fail"><Icon Name="trash" Size="18" /></span>
            <h2>Delete profile @name?</h2>
        </div>
        <p class="ads-muted">This edits only the local settings file. Nothing in Azure is touched; the resource group stays.</p>
        <div class="form-check">
            <input id="delete-work" class="form-check-input" type="checkbox" @bind="_deleteWorkFolder" />
            <label class="form-check-label" for="delete-work">Also delete its work folder (source copy, logs, history)</label>
        </div>
        <div class="ads-card-footer justify-content-end">
            <button class="btn btn-outline-secondary" @onclick="() => _pendingDelete = null">Cancel</button>
            <button class="btn btn-danger" @onclick="ConfirmDeleteAsync"><Icon Name="trash" Size="14" /> Delete</button>
        </div>
    </div>
}

@if (_profiles is null)
{
    <p class="ads-muted">Loading…</p>
}
else if (_profiles.Count == 0 && _error is null)
{
    <div class="ads-empty">
        <span class="ads-tile-icon"><Icon Name="sliders" Size="24" /></span>
        <h2>No profiles yet</h2>
        <p class="mb-2">Create one from a discovered AppHost.</p>
        <a class="btn btn-primary" href="profiles/new"><Icon Name="plus" Size="15" /> New profile</a>
    </div>
}
else
{
    @foreach (var p in _profiles)
    {
        var running = Runs.TryGet("deploy:" + p.Name)?.IsRunning == true;
        <div class="ads-card ads-card-interactive ads-profile">
            <span class="ads-tile-icon @(running ? "ads-tone-run" : "ads-tone-neutral")"><Icon Name="@(p.SourceKind == SourceKind.GitHub ? "github" : "folder")" Size="18" /></span>
            <div class="ads-profile-body">
                <div class="ads-profile-title">
                    <a href="profiles/@p.Name">@p.Name</a>
                    <span class="ads-chip">@p.SourceKind</span>
                    @if (running)
                    {
                        <span class="ads-pill ads-pill-run">Deploying</span>
                    }
                </div>
                <div class="ads-meta">
                    <span><Icon Name="@(p.SourceKind == SourceKind.GitHub ? "code" : "server")" Size="13" /> @p.SourceDisplay</span>
                    @if (p.SubscriptionId is { Length: > 0 } sub)
                    {
                        <span class="ads-meta-sep">·</span>
                        <span title="@sub">
                            <Icon Name="key" Size="13" /> Sub: @Short(sub)
                            <button class="btn btn-sm btn-ghost ads-inline-copy" title="Copy subscription ID" aria-label="Copy subscription ID" @onclick="() => CopyAsync(sub)">
                                <Icon Name="@(_copied == sub ? "check" : "copy")" Size="12" />
                            </button>
                        </span>
                    }
                    @if (p.ResourceGroup is { Length: > 0 } rg)
                    {
                        <span class="ads-meta-sep">·</span>
                        <span><Icon Name="cloud" Size="13" /> @rg</span>
                    }
                    @if (p.RegistryName is { Length: > 0 } registry)
                    {
                        <span class="ads-meta-sep">·</span>
                        <span title="Container registry"><Icon Name="server" Size="13" /> @registry</span>
                    }
                    @if (p.EnvironmentName is { Length: > 0 } environment)
                    {
                        <span class="ads-meta-sep">·</span>
                        <span title="Container Apps environment"><Icon Name="cloud" Size="13" /> @environment</span>
                    }
                </div>
            </div>
            <div class="ads-profile-actions">
                <a class="btn btn-primary btn-sm" href="deploy/@p.Name">
                    @if (running)
                    {
                        <span class="ads-spinner ads-spinner-sm"></span> <span>Deploying…</span>
                    }
                    else
                    {
                        <Icon Name="play" Size="12" /> <span>Deploy</span>
                    }
                </a>
                <a class="btn btn-outline-secondary btn-sm" href="profiles/@p.Name"><Icon Name="pencil" Size="12" /> Edit</a>
                <button class="btn btn-outline-danger btn-sm btn-icon" disabled="@running" title="Delete" aria-label="Delete @p.Name" @onclick="() => AskDelete(p.Name)">
                    <Icon Name="trash" Size="13" />
                </button>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<ProfileSummary>? _profiles;
    private string? _error;
    private string? _pendingDelete;
    private bool _deleteWorkFolder = true;
    private string? _copied;

    protected override async Task OnInitializedAsync()
    {
        Runs.RunsChanged += OnRunsChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var location = ProfileService.Location;
        if (location.ParseError is { } parse)
        {
            _error = $"The settings file cannot be read ({location.Path}): {parse}";
            _profiles = [];
            return;
        }
        _profiles = await ProfileService.ListAsync(CancellationToken.None);
    }

    private void AskDelete(string name)
    {
        _pendingDelete = name;
        _deleteWorkFolder = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        var name = _pendingDelete!;
        _pendingDelete = null;
        try
        {
            await Task.Run(() => ProfileService.DeleteAsync(name, _deleteWorkFolder, CancellationToken.None));
            _error = null;
        }
        catch (DeployerException ex)
        {
            _error = ex.Message;
        }
        await LoadAsync();
    }

    private async Task CopyAsync(string text)
    {
        await Clipboard.Default.SetTextAsync(text);
        _copied = text;
    }

    private static string Short(string id) => id.Length > 12 ? id[..8] + "…" : id;

    private void OnRunsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Runs.RunsChanged -= OnRunsChanged;
}
