@page "/profiles/new"
@implements IDisposable
@inject IProfileService Profiles
@inject IDiscoveryService Discovery
@inject IAzureAccountService Azure
@inject RunCoordinator Runs
@inject NavigationManager Nav

@{
    var stage = _savedName is not null ? 4 : _run?.ValueAs<WizardData>() is not null ? 2 : 1;
}

<header class="ads-page-header">
    <div class="ads-page-text">
        <div class="ads-eyebrow"><a href="profiles" class="ads-eyebrow-link"><Icon Name="arrow-left" Size="12" /> Profiles</a></div>
        <h1>New profile</h1>
        <p class="ads-lead">Discover the AppHost, then fill in the destination and the parameters it needs.</p>
    </div>
</header>

<div class="ads-stepper" aria-label="Progress">
    <span class="ads-stepper-item @StepClass(1, stage)"><span class="ads-stepper-num">@(stage > 1 ? "✓" : "1")</span> Source</span>
    <span class="ads-stepper-line"></span>
    <span class="ads-stepper-item @StepClass(2, stage)"><span class="ads-stepper-num">@(stage > 3 ? "✓" : "2")</span> Destination</span>
    <span class="ads-stepper-line"></span>
    <span class="ads-stepper-item @StepClass(3, stage)"><span class="ads-stepper-num">@(stage > 3 ? "✓" : "3")</span> Parameters</span>
</div>

<div class="ads-card mb-4">
    <div class="ads-card-header"><span class="ads-stepper-num-sm">1</span><h2>Source</h2></div>
    <div class="ads-form-grid mb-3">
        <div class="ads-span-6">
            <label class="form-label" for="pn-name">Profile name</label>
            <input id="pn-name" class="form-control ads-mono-input" placeholder="orders-dev" @bind="_name" @bind:event="oninput" disabled="@Busy" />
            @if (_name is { Length: > 0 } && !ProfileRules.IsValidName(_name))
            {
                <div class="form-text text-danger">2 to 40 lower-case letters, digits or dashes, starting with a letter or digit.</div>
            }
            else
            {
                <div class="form-text">2 to 40 lower-case letters, digits or dashes.</div>
            }
        </div>
    </div>
    <SourcePicker Id="pn" @bind-Kind="_kind" @bind-Location="_location" @bind-Ref="_ref" @bind-AppHostPath="_appHost" Disabled="@Busy" />
    <div class="ads-card-footer">
        <div class="form-check mb-0">
            <input id="pn-overwrite" class="form-check-input" type="checkbox" @bind="_overwrite" disabled="@Busy" />
            <label class="form-check-label" for="pn-overwrite">Overwrite an existing profile with this name</label>
        </div>
        <span class="ads-spacer"></span>
        <button class="btn btn-primary" disabled="@(Busy || !ProfileRules.IsValidName(_name) || string.IsNullOrWhiteSpace(_location))" @onclick="Discover">
            @if (Busy)
            {
                <span class="ads-spinner ads-spinner-sm"></span> <span>Discovering…</span>
            }
            else
            {
                <Icon Name="search" Size="15" /> <span>Discover</span>
            }
        </button>
    </div>
</div>

<OutcomeBanner Run="_run" Page="New profile" />

@if (_run?.ValueAs<WizardData>() is { } data && _form is { } p)
{
    <div class="ads-stack mb-3">
        @foreach (var w in data.Draft.Warnings.Concat(data.Discovery.Warnings))
        {
            <div class="ads-callout ads-callout-warn">
                <Icon Name="alert-triangle" Size="17" />
                <div class="ads-callout-body">@w</div>
                <AIHelpButton GetContext="@(() => AIHelpContexts.FromWarning("New profile", w, _run))" Compact="true" />
            </div>
        }

        <div class="ads-card">
            <div class="ads-card-header"><span class="ads-stepper-num-sm">2</span><h2>Destination</h2></div>
            <div class="ads-form-grid">
                <div class="ads-span-8">
                    <label class="form-label" for="pn-sub">
                        Subscription
                        @if (data.Subscriptions.Count > 0 && !_typeSubscription)
                        {
                            <button class="btn btn-link btn-sm ms-auto p-0" @onclick="() => _typeSubscription = true">Type an ID instead</button>
                        }
                    </label>
                    @if (data.Subscriptions.Count > 0 && !_typeSubscription)
                    {
                        <select id="pn-sub" class="form-select" value="@p.Destination.SubscriptionId" @onchange="e => PickSubscription(data, e.Value?.ToString())">
                            <option value="">Choose…</option>
                            @foreach (var s in data.Subscriptions)
                            {
                                <option value="@s.Id">@s.Name (@s.Id)@(s.IsDefault ? " — default" : "")</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input id="pn-sub" class="form-control ads-mono-input" placeholder="subscription GUID" @bind="p.Destination.SubscriptionId" />
                    }
                </div>
                <div class="ads-span-4">
                    <label class="form-label" for="pn-tenant">Tenant ID</label>
                    <input id="pn-tenant" class="form-control ads-mono-input" placeholder="(az login tenant)" @bind="p.Destination.TenantId" />
                </div>
                <div class="ads-span-4">
                    <label class="form-label" for="pn-loc">Region</label>
                    <input id="pn-loc" class="form-control ads-mono-input" placeholder="eastus2" @bind="p.Destination.Location" />
                </div>
                <div class="ads-span-4">
                    <label class="form-label" for="pn-rg">Resource group</label>
                    <input id="pn-rg" class="form-control ads-mono-input" @bind="p.Destination.ResourceGroup" />
                </div>
                <div class="ads-span-4">
                    <label class="form-label" for="pn-env">Environment</label>
                    <input id="pn-env" class="form-control" @bind="p.Environment" />
                </div>
            </div>
        </div>

        <div class="ads-card">
            <div class="ads-card-header"><span class="ads-stepper-num-sm">3</span><h2>Parameters</h2></div>
            @if (data.Draft.ToAsk.Count == 0)
            {
                <p class="ads-muted">This AppHost needs no parameter values.</p>
            }
            <div class="ads-stack">
                @foreach (var param in data.Draft.ToAsk)
                {
                    var supplied = _appHostSupplies.Contains(param.Name);
                    <div>
                        <label class="form-label" for="pn-p-@param.Name">
                            <code>@param.Name</code>
                            <span class="ads-label-hint">@param.ConfigKey@(param.Secret ? " · secret" : "")</span>
                        </label>
                        @if (param.Secret)
                        {
                            <SecretInput Id="@($"pn-p-{param.Name}")" Value="@_values.GetValueOrDefault(param.Name)" ValueChanged="v => _values[param.Name] = v" Disabled="@supplied" />
                        }
                        else
                        {
                            <input id="pn-p-@param.Name" class="form-control ads-mono-input" value="@_values.GetValueOrDefault(param.Name)" disabled="@supplied"
                                   @onchange="e => _values[param.Name] = e.Value?.ToString()" />
                        }
                        <div class="form-check mt-2">
                            <input id="pn-s-@param.Name" class="form-check-input" type="checkbox" checked="@supplied"
                                   @onchange="e => Toggle(param.Name, (bool)e.Value!)" />
                            <label class="form-check-label ads-small" for="pn-s-@param.Name">Leave empty (the AppHost's own configuration supplies it)</label>
                        </div>
                    </div>
                }
            </div>
            @if (data.Draft.Optional.Count > 0)
            {
                <p class="ads-small ads-subtle mt-3 mb-0">
                    Not asked, because they have a default or are generated: @string.Join(", ", data.Draft.Optional.Select(o => o.Name)).
                    You can override them later on the profile page.
                </p>
            }

            <div class="ads-card-footer">
                @if (_saveError is { } se)
                {
                    <div class="ads-callout ads-callout-error w-100">
                        <Icon Name="x-circle" Size="17" />
                        <div class="ads-callout-body ads-pre-line">@se</div>
                        <AIHelpButton GetContext="@(() => AIHelpContexts.FromError("New profile", se))" Compact="true" />
                    </div>
                }
                @if (_savedName is { } saved)
                {
                    <div class="ads-banner ads-banner-success w-100 mb-0">
                        <span class="ads-banner-icon"><Icon Name="check-circle" Size="18" /></span>
                        <div class="ads-banner-body">
                            <span class="ads-banner-title">Profile @saved saved.</span>
                            <span class="ads-muted"> <a href="deploy/@saved">Deploy it</a> or <a href="profiles/@saved">review it</a>.</span>
                        </div>
                    </div>
                }
                else
                {
                    <span class="ads-spacer"></span>
                    <button class="btn btn-primary" @onclick="() => SaveAsync(data)"><Icon Name="check" Size="15" /> Save profile</button>
                }
            </div>
        </div>
    </div>
}

<LogViewer Run="_run" Page="New profile" />

@code {
    [SupplyParameterFromQuery(Name = "kind")] public string? QueryKind { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public string? QueryLocation { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? QueryRef { get; set; }
    [SupplyParameterFromQuery(Name = "apphost")] public string? QueryAppHost { get; set; }

    private sealed record WizardData(string Name, SourceSpec Source, DiscoveryResult Discovery, ProfileDraft Draft, IReadOnlyList<AzureSubscription> Subscriptions);

    private string? _name;
    private SourceKind _kind = SourceKind.LocalFolder;
    private string? _location;
    private string? _ref;
    private string? _appHost;
    private bool _overwrite;
    private bool _typeSubscription;
    private ActiveRun? _run;
    private DeployProfile? _form;
    private WizardData? _formFor;
    private readonly Dictionary<string, string?> _values = new(StringComparer.Ordinal);
    private readonly HashSet<string> _appHostSupplies = new(StringComparer.Ordinal);
    private string? _saveError;
    private string? _savedName;

    private bool Busy => _run?.IsRunning == true;

    private static string StepClass(int step, int stage) => stage > step ? "is-done" : stage == step || (stage == 2 && step == 3) ? "is-active" : "";

    protected override void OnInitialized()
    {
        Runs.RunsChanged += OnRunsChanged;
        // A wizard run that is still going wins over query parameters, so the page shows what is really running.
        var latest = Runs.Latest("profile:new");
        if (latest is { IsRunning: true } || (!Enum.TryParse<SourceKind>(QueryKind, out _) && latest is not null))
            Attach(latest);
        else if (Enum.TryParse<SourceKind>(QueryKind, out var kind))
            (_kind, _location, _ref, _appHost) = (kind, QueryLocation, QueryRef, QueryAppHost);
        PrepareForm();
    }

    private void Attach(ActiveRun run)
    {
        _run = run;
        if (run.Tag is WizardInput input)
            (_name, _kind, _location, _ref, _appHost, _overwrite) = input;
    }

    private sealed record WizardInput(string? Name, SourceKind Kind, string? Location, string? Ref, string? AppHost, bool Overwrite);

    private void Discover()
    {
        var name = _name!;
        var spec = new SourceSpec(_kind, _location!, _kind == SourceKind.GitHub ? _ref : null, _appHost);
        var overwrite = _overwrite;
        _savedName = null;
        _saveError = null;
        var input = new WizardInput(_name, _kind, _location, _ref, _appHost, _overwrite);
        var run = Runs.Start("profile:new", "New profile", async (observer, ct) =>
        {
            if (!overwrite && await Profiles.GetAsync(name, ct) is not null)
                throw new DeployerException(OutcomeCode.InvalidInput, $"Profile '{name}' already exists. Tick Overwrite to replace it.");
            var discovery = await Discovery.DiscoverAsync(new DiscoverRequest(spec, null, StaticOnly: false), observer, ct);
            if (!discovery.AppHost.HasAzureTarget)
                throw new DeployerException(OutcomeCode.DiscoveryFailed,
                    "The AppHost declares no Azure compute environment. Add, for example, builder.AddAzureContainerAppEnvironment(\"env\"); "
                    + "with the Aspire.Hosting.Azure.AppContainers package, then discover again.");
            if (discovery.UsesSubmodulesOrLfs && spec.Kind == SourceKind.GitHub)
                throw new DeployerException(OutcomeCode.DiscoveryFailed, "This repository uses submodules or Git LFS; clone it and use a local folder source.");
            var subscriptions = await Azure.ListSubscriptionsAsync(observer, ct);
            var draft = await Profiles.DraftFromDiscoveryAsync(name, spec, discovery, ct);
            return new WizardData(name, spec, discovery, draft, subscriptions);
        }, d => OperationResult.Ok($"Discovered {d.Discovery.AppHost.AppHostPath} (Aspire {d.Discovery.AppHost.AspireSdkVersion}). Fill in the form below."),
        tag: input);
        Attach(run); // if another wizard run was still going, this shows that run's input instead of ours
    }

    /// <summary>Builds the editable form once the discovery run has produced a draft.</summary>
    private void PrepareForm()
    {
        if (_run?.ValueAs<WizardData>() is not { } data || ReferenceEquals(data, _formFor))
            return;
        _formFor = data;
        _form = data.Draft.Profile.Clone();
        _values.Clear();
        _appHostSupplies.Clear();
        _typeSubscription = data.Subscriptions.Count == 0;
        if (data.Subscriptions.FirstOrDefault(s => s.IsDefault) is { } def)
            (_form.Destination.SubscriptionId, _form.Destination.TenantId) = (def.Id, def.TenantId);
    }

    private void PickSubscription(WizardData data, string? id)
    {
        _form!.Destination.SubscriptionId = id;
        if (data.Subscriptions.FirstOrDefault(s => s.Id == id) is { } s)
            _form.Destination.TenantId = s.TenantId;
    }

    private void Toggle(string name, bool supplied)
    {
        if (supplied) _appHostSupplies.Add(name); else _appHostSupplies.Remove(name);
    }

    private async Task SaveAsync(WizardData data)
    {
        _saveError = null;
        var profile = _form!.Clone();
        var missing = new List<string>();
        foreach (var param in data.Draft.ToAsk)
        {
            if (_appHostSupplies.Contains(param.Name))
                profile.Parameters[param.Name] = "";
            else if (_values.GetValueOrDefault(param.Name) is { Length: > 0 } value)
                profile.Parameters[param.Name] = value;
            else
                missing.Add(param.Name);
        }
        if (missing.Count > 0)
        {
            _saveError = $"Enter a value, or tick \"Leave empty\", for: {string.Join(", ", missing)}.";
            return;
        }

        try
        {
            await Profiles.SaveAsync(data.Name, profile, _overwrite, CancellationToken.None);
            _savedName = data.Name;
        }
        catch (DeployerException ex)
        {
            _saveError = ex.Message;
        }
    }

    private void OnRunsChanged() => _ = InvokeAsync(() =>
    {
        PrepareForm();
        StateHasChanged();
    });

    public void Dispose() => Runs.RunsChanged -= OnRunsChanged;
}
