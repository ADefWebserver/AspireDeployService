@if (Run is { } run)
{
    @if (run.IsRunning)
    {
        <div class="ads-banner ads-banner-running" role="status">
            <span class="ads-banner-icon"><span class="ads-spinner"></span></span>
            <div class="ads-banner-body">
                <span class="ads-banner-title">@run.Title is running</span>
                @if (run.CancelRequested)
                {
                    <span class="ads-muted"> · stopping…</span>
                }
            </div>
            <button class="btn btn-sm btn-outline-danger" disabled="@run.CancelRequested" @onclick="run.Cancel">
                <Icon Name="x" Size="14" /> @(run.CancelRequested ? "Stopping…" : "Cancel")
            </button>
        </div>
    }
    else if (run.Result is { } result)
    {
        <div class="ads-banner @(result.Succeeded ? "ads-banner-success" : "ads-banner-error")" role="status">
            <span class="ads-banner-icon"><Icon Name="@(result.Succeeded ? "check-circle" : "x-circle")" Size="18" /></span>
            <div class="ads-banner-body">
                <div class="ads-banner-title ads-pre-line">@result.Message</div>
                @if (!result.Succeeded)
                {
                    <div class="ads-banner-detail">
                        Result code @((int)result.Code) (@result.Code)@(result.Category is ErrorCategory.None or ErrorCategory.Unknown ? "" : $", category {result.Category}")
                    </div>
                }
                @if (ExtraLine is { Length: > 0 })
                {
                    <div class="ads-small ads-muted mt-1">@ExtraLine</div>
                }
            </div>
            @if (!result.Succeeded && result.Code != OutcomeCode.Declined && result.Category != ErrorCategory.Canceled)
            {
                <AIHelpButton GetContext="@(() => AIHelpContexts.FromRun(run, Page, ExtraLine))" />
            }
        </div>
    }
}

@code {
    [Parameter] public ActiveRun? Run { get; set; }

    /// <summary>For example the resource group, shown under the result.</summary>
    [Parameter] public string? ExtraLine { get; set; }

    /// <summary>The page name ("Setup", "Deploy", "New profile"), sent to AI Help as the Page fact.</summary>
    [Parameter] public string? Page { get; set; }
}
