@if (Run is { } run)
{
    @if (run.IsRunning)
    {
        <div class="alert alert-info d-flex align-items-center gap-3">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span class="flex-grow-1">@run.Title is running@(run.CancelRequested ? " (stopping…)" : "")</span>
            <button class="btn btn-sm btn-outline-danger" disabled="@run.CancelRequested" @onclick="run.Cancel">Cancel</button>
        </div>
    }
    else if (run.Result is { } result)
    {
        <div class="alert @(result.Succeeded ? "alert-success" : "alert-danger")">
            <div class="ads-pre-line">@result.Message</div>
            @if (!result.Succeeded)
            {
                <div class="small mt-2">
                    Result code @((int)result.Code) (@result.Code)@(result.Category is ErrorCategory.None or ErrorCategory.Unknown ? "" : $", category {result.Category}")
                </div>
            }
            @if (ExtraLine is { Length: > 0 })
            {
                <div class="small mt-1">@ExtraLine</div>
            }
        </div>
    }
}

@code {
    [Parameter] public ActiveRun? Run { get; set; }

    /// <summary>For example the resource group, shown under the result.</summary>
    [Parameter] public string? ExtraLine { get; set; }
}
