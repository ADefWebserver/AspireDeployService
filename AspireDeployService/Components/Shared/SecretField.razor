@* A saved secret: never loaded into an input (plan §6.1). Reveal shows it read-only; Replace opens an empty input. *@
<div class="d-flex flex-wrap align-items-center gap-2">
    @if (Replacement is not null)
    {
        <div class="flex-grow-1"><SecretInput Value="@Replacement" ValueChanged="ReplacementChanged" Placeholder="@($"new {Label}")" /></div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ReplacementChanged.InvokeAsync(null)">Keep current</button>
    }
    else if (Cleared)
    {
        <span class="text-muted">(will be cleared)</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ClearedChanged.InvokeAsync(false)">Undo</button>
    }
    else
    {
        <span>@(HasValue ? "(set)" : "(empty)")</span>
        @if (HasValue)
        {
            @if (_revealed)
            {
                <code class="user-select-all">@Original</code>
                <button type="button" class="btn btn-sm btn-link" @onclick="() => _revealed = false">Hide</button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-link" @onclick="() => _revealed = true">Reveal</button>
            }
            <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => ClearedChanged.InvokeAsync(true)">Clear</button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ReplacementChanged.InvokeAsync(string.Empty)">Replace</button>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "value";
    [Parameter] public bool HasValue { get; set; }
    [Parameter] public string? Original { get; set; }
    [Parameter] public string? Replacement { get; set; }
    [Parameter] public EventCallback<string?> ReplacementChanged { get; set; }
    [Parameter] public bool Cleared { get; set; }
    [Parameter] public EventCallback<bool> ClearedChanged { get; set; }

    private bool _revealed;
}
