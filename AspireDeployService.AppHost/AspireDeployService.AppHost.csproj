<Project Sdk="Aspire.AppHost.Sdk/13.6.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>2394ad6b-82b4-4cdd-9091-91a1a68d807d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MAUI app is Windows-only; Aspire's MAUI integration builds and launches it as a Windows device. -->
    <PackageReference Include="Aspire.Hosting.Maui" Version="13.6.3-preview.1.26521.2" />
    <!-- Lifts the transitive MessagePack 2.5.302 past GHSA-qhrr-8q5h-9q3h (fixed in 2.5.303). -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

</Project>
